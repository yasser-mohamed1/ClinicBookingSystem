@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="flex flex-col md:flex-row items-start justify-center gap-12">
    <div class="w-full md:w-1/2 lg:w-2/5">
        <div class="bg-white p-8 rounded-lg shadow-md">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">@ViewData["Title"]</h1>
            <p class="text-gray-600 mb-6">Create a new account.</p>
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm" role="alert"></div>
                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700">Email</label>
                    <div class="mt-1">
                        <input asp-for="Input.Email" class="block w-full px-4 py-2 text-gray-700 bg-white border border-gray-200 rounded-md focus:border-blue-400 focus:ring-blue-300 focus:ring-opacity-40 focus:outline-none focus:ring" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium text-gray-700">Password</label>
                    <div class="mt-1">
                        <input asp-for="Input.Password" class="block w-full px-4 py-2 text-gray-700 bg-white border border-gray-200 rounded-md focus:border-blue-400 focus:ring-blue-300 focus:ring-opacity-40 focus:outline-none focus:ring" autocomplete="new-password" aria-required="true" placeholder="password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-700">Confirm Password</label>
                    <div class="mt-1">
                        <input asp-for="Input.ConfirmPassword" class="block w-full px-4 py-2 text-gray-700 bg-white border border-gray-200 rounded-md focus:border-blue-400 focus:ring-blue-300 focus:ring-opacity-40 focus:outline-none focus:ring" autocomplete="new-password" aria-required="true" placeholder="password" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs"></span>
                </div>
                <button id="registerSubmit" type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">Register</button>
            </form>
        </div>
    </div>
