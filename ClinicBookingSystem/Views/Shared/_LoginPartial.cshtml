﻿@using Microsoft.AspNetCore.Identity
@using ClinicBookingSystem.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="flex items-center space-x-4">
@if (SignInManager.IsSignedIn(User))
{
    <a id="manage" class="px-3 py-2 text-gray-700 hover:text-blue-600 font-medium" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
        Hello @UserManager.GetUserName(User)!
    </a>
    <form id="logoutForm" class="m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button id="logout" type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            Logout
        </button>
        </form>
}
else
{
    <a class="px-3 py-2 text-gray-700 hover:text-blue-600 font-medium" id="register" asp-area="Identity" asp-page="/Account/Register">
        Register
    </a>
    <a class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" id="login" asp-area="Identity" asp-page="/Account/Login">
        Login
    </a>
}
</div>
