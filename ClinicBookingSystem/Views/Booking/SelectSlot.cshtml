@model ClinicBookingSystem.ViewModels.BookAppointmentViewModel
@{
    ViewData["Title"] = "Select Appointment Time";
    var prevDate = Model.SelectedDate.AddDays(-1);
    var nextDate = Model.SelectedDate.AddDays(1);
}

<div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <a asp-action="SelectDoctor" class="text-sm text-gray-500 hover:text-gray-700 mb-4 inline-flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Back to Doctors
        </a>
        <h2 class="text-2xl font-bold text-gray-900">Book with Dr. @Model.DoctorName</h2>
        <p class="text-gray-600">@Model.Specialization</p>
    </div>

    <form asp-action="ReviewBooking" method="post">
        <input type="hidden" asp-for="DoctorId" />
        <input type="hidden" asp-for="DoctorName" />
        <input type="hidden" asp-for="Specialization" />
        <input type="hidden" asp-for="SelectedDate" />

        <!-- Date Selection (Simplified Calendar) -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    Select Date: @Model.SelectedDate.ToString("MMMM yyyy")
                </h3>
                <div class="flex space-x-2">
                    @if (prevDate >= DateTime.Today)
                    {
                        <a asp-action="SelectSlot" asp-route-doctorId="@Model.DoctorId" asp-route-date="@prevDate.ToString("yyyy-MM-dd")" class="p-2 rounded-full hover:bg-gray-100 border border-gray-200 text-gray-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                        </a>
                    }
                    <a asp-action="SelectSlot" asp-route-doctorId="@Model.DoctorId" asp-route-date="@nextDate.ToString("yyyy-MM-dd")" class="p-2 rounded-full hover:bg-gray-100 border border-gray-200 text-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg>
                    </a>
                </div>
            </div>

            <!-- Day Scroller -->
            <div class="flex space-x-2 overflow-x-auto pb-2">
                @for (int i = 0; i < 7; i++)
                {
                    var day = DateTime.Today.AddDays(i);
                    bool isSelected = day.Date == Model.SelectedDate.Date;
                    <a asp-action="SelectSlot" asp-route-doctorId="@Model.DoctorId" asp-route-date="@day.ToString("yyyy-MM-dd")"
                       class="flex-shrink-0 flex flex-col items-center justify-center w-16 h-20 rounded-lg border-2 transition-all
                              @(isSelected ? "border-blue-600 bg-blue-50 text-blue-700" : "border-gray-200 hover:border-gray-300 text-gray-700")">
                        <span class="text-xs font-medium uppercase">@day.ToString("ddd")</span>
                        <span class="text-2xl font-bold">@day.Day</span>
                    </a>
                }
            </div>
        </div>

        <!-- Time Slot Selection -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-6 flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Available Times for @Model.SelectedDate.ToString("ddd, MMM d")
            </h3>

            @if (Model.AvailableSlots.Any())
            {
                <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3">
                    @foreach (var slot in Model.AvailableSlots)
                    {
                        <!-- Radio button hidden, label acts as button -->
                        <label class="cursor-pointer">
                            <input type="radio" asp-for="SelectedTime" value="@slot" class="peer sr-only" />
                            <div class="text-center py-2 px-4 rounded-lg border border-gray-300 font-medium text-gray-700
                                        hover:border-blue-500 peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 transition-all">
                                @DateTime.Today.Add(slot).ToString("hh:mm tt")
                            </div>
                        </label>
                    }
                </div>
                <span asp-validation-for="SelectedTime" class="text-red-500 text-sm mt-2 block"></span>

                <div class="mt-8">
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white text-lg font-semibold py-4 rounded-xl shadow-md transition-colors">
                        Continue to Details
                    </button>
                </div>
            }
            else
            {
                <div class="text-center py-8 bg-gray-50 rounded-lg border border-gray-200">
                    <p class="text-gray-500 font-medium">No available slots for this date.</p>
                    <p class="text-sm text-gray-400 mt-1">Please try selecting another day.</p>
                </div>
            }
        </div>
    </form>
</div>