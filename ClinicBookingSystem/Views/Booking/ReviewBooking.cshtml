@model ClinicBookingSystem.ViewModels.BookAppointmentViewModel
@{
    ViewData["Title"] = "Review & Confirm";
    var appointmentDateTime = Model.SelectedDate.Date + Model.SelectedTime!.Value;
}

<div class="max-w-lg mx-auto">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Almost Done!</h2>

    <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-6">
        <h3 class="text-blue-800 font-semibold mb-4">Appointment Summary</h3>
        <ul class="space-y-3 text-blue-900">
            <li class="flex justify-between">
                <span class="text-blue-700 opacity-75">Doctor:</span>
                <span class="font-medium">Dr. @Model.DoctorName (@Model.Specialization)</span>
            </li>
            <li class="flex justify-between">
                <span class="text-blue-700 opacity-75">Date:</span>
                <span class="font-medium">@appointmentDateTime.ToString("dddd, MMMM d, yyyy")</span>
            </li>
            <li class="flex justify-between">
                <span class="text-blue-700 opacity-75">Time:</span>
                <span class="font-bold">@appointmentDateTime.ToString("h:mm tt")</span>
            </li>
        </ul>
    </div>

    <form asp-action="ConfirmBooking" method="post" class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <input type="hidden" asp-for="DoctorId" />
        <input type="hidden" asp-for="SelectedDate" />
        <input type="hidden" asp-for="SelectedTime" />

        <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>

        <h3 class="text-lg font-semibold text-gray-900 mb-4">Enter Your Details</h3>

        <div class="space-y-4">
            <div>
                <label asp-for="PatientName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="PatientName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="e.g., John Doe" />
                <span asp-validation-for="PatientName" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="PatientPhone" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="PatientPhone" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="e.g., 01xxxxxxxxx" />
                <span asp-validation-for="PatientPhone" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="PatientEmail" class="block text-sm font-medium text-gray-700 mb-1">Email (Optional)</label>
                <input asp-for="PatientEmail" type="email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="john@example.com" />
                <span asp-validation-for="PatientEmail" class="text-red-500 text-sm"></span>
            </div>
        </div>

        <button type="submit" class="w-full mt-8 bg-green-600 hover:bg-green-700 text-white text-lg font-semibold py-4 rounded-xl shadow-md transition-colors flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Confirm Booking
        </button>
    </form>
</div>