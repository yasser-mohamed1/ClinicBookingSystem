@model IEnumerable<ClinicBookingSystem.Models.Doctor>
@{
    ViewData["Title"] = "Select a Doctor";
}

<div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-gray-900 mb-6">Select Your Doctor</h2>

    @if (ViewBag.SelectedSpecialization != null)
    {
        <div class="mb-6 flex items-center text-gray-600">
            <span>Showing specialists in: </span>
            <span class="ml-2 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-semibold">@ViewBag.SelectedSpecialization</span>
            <a asp-action="SelectDoctor" class="ml-4 text-blue-600 hover:underline text-sm">Clear Filter</a>
        </div>
    }

    <div class="grid gap-6 md:grid-cols-2">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
                <div>
                    <div class="flex items-start justify-between mb-4">
                        <div>
                            <h3 class="text-xl font-bold text-gray-900">Dr. @item.Name</h3>
                            <p class="text-blue-600 font-medium">@item.Specialization</p>
                        </div>
                        <div class="h-12 w-12 bg-gray-100 rounded-full flex items-center justify-center text-gray-400">
                            <!-- Placeholder User Icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                    </div>
                    <p class="text-gray-500 text-sm mb-4">
                        Consultation duration: @item.SlotDurationMinutes mins
                    </p>
                </div>
                <a asp-action="SelectSlot" asp-route-doctorId="@item.Id"
                   class="block w-full text-center bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold py-3 rounded-lg transition-colors">
                    View Availability
                </a>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12 text-gray-500 bg-gray-50 rounded-lg border border-dashed border-gray-300">
            <p>No doctors found matching criteria.</p>
        </div>
    }
</div>