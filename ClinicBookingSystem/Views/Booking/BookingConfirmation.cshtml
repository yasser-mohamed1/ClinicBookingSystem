@model ClinicBookingSystem.Models.Appointment
@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="max-w-md mx-auto text-center py-12">
    <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
    </div>
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Booking Received!</h1>
    <p class="text-gray-600 text-lg mb-8">Your appointment request has been sent successfully.</p>

    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm text-left mb-8">
        <div class="flex justify-between items-center mb-4 pb-4 border-b border-gray-100">
            <span class="text-gray-500">Status</span>
            <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm font-semibold">
                @Model.Status.ToString()
            </span>
        </div>
        <div class="space-y-3">
            <div>
                <span class="block text-xs text-gray-400 uppercase font-semibold">Doctor</span>
                <span class="text-gray-900 font-medium">Dr. @Model.Doctor?.Name</span>
            </div>
            <div>
                <span class="block text-xs text-gray-400 uppercase font-semibold">Time</span>
                <span class="text-gray-900 font-medium">@Model.AppointmentDateTime.ToString("f")</span>
            </div>
            <div>
                <span class="block text-xs text-gray-400 uppercase font-semibold">Patient</span>
                <span class="text-gray-900 font-medium">@Model.Patient?.Name</span>
            </div>
        </div>
    </div>

    <a asp-controller="Home" asp-action="Index" class="text-blue-600 hover:underline font-medium">
        Return to Home Page
    </a>
</div>