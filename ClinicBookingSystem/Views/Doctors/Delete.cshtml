@model ClinicBookingSystem.Models.Doctor
@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="max-w-md mx-auto mt-10">
    <div class="bg-white shadow-lg rounded-xl border border-red-100 overflow-hidden">
        <div class="bg-red-50 p-4 border-b border-red-100 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <h2 class="text-lg font-bold text-red-800">Confirm Deletion</h2>
        </div>

        <div class="p-6">
            <p class="text-gray-600 mb-4">
                Are you sure you want to delete <span class="font-bold text-gray-900">Dr. @Model.Name</span>?
            </p>

            <div class="bg-gray-50 rounded-lg p-4 mb-6 text-sm text-gray-500">
                <p><span class="font-semibold">Specialization:</span> @Model.Specialization</p>
                <p><span class="font-semibold">Consultation Time:</span> @Model.SlotDurationMinutes mins</p>
                <p class="mt-2 text-red-500 italic text-xs">Warning: This action cannot be undone.</p>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="flex items-center justify-end space-x-3">
                    <a asp-action="Index" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition-colors">
                        Cancel
                    </a>
                    <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-semibold shadow transition-colors">
                        Delete Doctor
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>