@model ClinicBookingSystem.Models.Doctor
@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="max-w-md mx-auto">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Edit Doctor Details</h2>

    <form asp-action="Edit" class="bg-white shadow-sm rounded-xl border border-gray-200 p-6">
        <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>

        <!-- Hidden ID is crucial for Edit -->
        <input type="hidden" asp-for="Id" />

        <div class="mb-4">
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">Doctor Name</label>
            <div class="flex">
                <span class="inline-flex items-center px-3 rounded-l-md border border-r-0 border-gray-300 bg-gray-50 text-gray-500 text-sm">Dr.</span>
                <input asp-for="Name" class="flex-1 block w-full rounded-none rounded-r-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm border p-2" />
            </div>
            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Specialization" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Specialization" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm border p-2" />
            <span asp-validation-for="Specialization" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="mb-6">
            <label asp-for="SlotDurationMinutes" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="SlotDurationMinutes" type="number" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm border p-2" />
            <p class="text-xs text-gray-500 mt-1">Standard duration for one patient appointment.</p>
            <span asp-validation-for="SlotDurationMinutes" class="text-red-500 text-xs mt-1"></span>
        </div>

        <div class="flex items-center justify-end space-x-4">
            <a asp-action="Index" class="text-gray-600 hover:text-gray-900 text-sm font-medium">Cancel</a>
            <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-white font-semibold py-2 px-6 rounded-lg shadow transition-colors">
                Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}